{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wiki-context",
  "version": "0.5.4",
  "identifier": "io.wikicontext.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../src/wiki_context/ui_dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wiki-context 控制中心",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/engine/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNzExNUNBNEM1NUFDQUUKUldTdXJGVk15aFZ4N0xiQWgxdTZQLy82QTVkVjNVL0VGS0R5SlVQTGU0Z3pmNmdMOVlEekxLb3gK",
      "endpoints": [
        "https://github.com/Minokun/wiki-context/releases/latest/download/latest.json"
      ]
    }
  }
}
